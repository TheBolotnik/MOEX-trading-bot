# Environment example for MOEX Trading Signal Bot
# Copy to .env and fill in real values. Never commit .env.

# T-Invest API token (Sandbox or read-only)
TINKOFF_TOKEN=

# Use sandbox endpoints by default in development
TINKOFF_SANDBOX=true

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Optional: default chat for notifications
TELEGRAM_CHAT_ID=

# SQLite database path (relative to project root)
DATABASE_URL=sqlite:///./data/moex_bot.db

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Strategy config path
STRATEGY_CONFIG_PATH=app/config/strategy.yaml
